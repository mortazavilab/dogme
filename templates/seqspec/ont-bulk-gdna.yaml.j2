!Assay
seqspec_version: 0.3.0
assay_id: ont-bulk-gdna
name: Bulk genomic DNA sequencing (Oxford Nanopore)
doi: ""
date: "{{ date }}"
description: bulk native genomic DNA, ligation library, sequenced on ONT; no barcode, no UMI, adapters trimmed at basecalling
modalities:
  - dna
sequence_protocol: Oxford Nanopore PromethION
sequence_kit: SQK-LSK114
library_protocol: ONT Ligation Sequencing gDNA
library_kit: SQK-LSK114
sequence_spec:
  - !Read
    read_id: {{ read_file_id }}
    name: gDNA read
    modality: dna
    primer_id: gdna
    min_len: {{ read_min_length }}
    max_len: {{ read_max_length }}
    strand: pos
    files:
      - !File
        file_id: {{ read_file_id }}
        filename: {{ read_file_name }}
        filetype: {{ read_file_type }}
        filesize: {{ read_file_size }}
        url: {{ read_url }}
        urltype: {{ read_urltype }}
        md5: {{ read_md5sum }}
library_spec:
  - !Region
    region_id: dna
    region_type: dna
    name: dna
    sequence_type: joined
    min_len: {{ read_min_length }}
    max_len: {{ read_max_length }}
    onlist: null
    regions:
      - !Region
        region_id: gdna
        region_type: gdna
        name: genomic DNA fragment
        sequence_type: random
        sequence: X
        min_len: {{ read_min_length }}
        max_len: {{ read_max_length }}
        onlist: null
        regions: null
